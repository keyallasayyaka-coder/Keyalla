<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="Website tentang Dota 2">
    <title>Dota 2 Website</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #0f172a;
            color: white;
        }

        header {
            background-color: #1e293b;
            padding: 20px;
            text-align: center;
        }

        nav {
            background-color: #334155;
            padding: 10px;
            text-align: center;
        }

        nav a {
            color: white;
            margin: 10px;
            text-decoration: none;
            font-weight: bold;
        }

        nav a:hover {
            color: orange;
        }

        .container {
            padding: 20px;
        }

        img {
            width: 100%;
            max-width: 600px;
            display: block;
            margin: 20px auto;
            border-radius: 10px;
        }

        footer {
            background-color: #1e293b;
            text-align: center;
            padding: 10px;
            margin-top: 20px;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>DOTA 2</h1>
        <p>Game MOBA Terpopuler di Dunia</p>
    </header>

    <!-- Menu Navigasi -->
    <nav>
        <a href="#home">Home</a>
        <a href="#hero">Hero</a>
        <a href="#gameplay">Gameplay</a>
        <a href="#about">About</a>
    </nav>

    <!-- Konten -->
    <div class="container">

        <!-- Home -->
        <section id="home">
            <h2>Tentang Dota 2</h2>
            <p>
                Dota 2 adalah game MOBA yang dikembangkan oleh Valve.
                Dua tim berisi 5 pemain bertarung untuk menghancurkan Ancient lawan.
                Yang terdiri dari berbagai hero dengan kemampuan unik dan strategi yang mendalam.
                Didalam Team terdapat 5 Role yaitu Carry, Offlaner, Midlaner, Support dan Hard Support.
            </p>

            <img src="https://cdn.cloudflare.steamstatic.com/apps/dota2/images/dota2_social.jpg" alt="Dota 2">
        </section>

        <!-- Hero -->
        <section id="hero">
            <h2>Hero Populer</h2>
            <ul>
                <li>Invoker</li>
                <li>Juggernaut</li>
                <li>Pudge</li>
                <li>Meepo</li>
            </ul>

        </section>

        <!-- Gameplay -->
        <section id="gameplay">
            <h2>Cara Bermain</h2>
            <ol>
                <li>Pilih Hero Sesuai Role</li>
                <li>Kumpulkan Gold</li>
                <li>Beli Item</li>
                <li>Hancurkan Objectives</li>
                <li>Menangkan Game</li>
            </ol>
        </section>

        <!-- About -->
        <section id="about">
            <h2>About</h2>
            <p>
                Website ini dibuat untuk tugas HTML dasar dengan tema Dota 2.
            </p>
        </section>

    </div>

    <!-- Footer -->
    <footer>
        <p>© 2026 Website Dota 2 | Tugas HTML</p>
    </footer>

</body>
</html>
